# BIST — Yahoo (default) | borsapy | twelvedata | auto
# BIST_DATA_PROVIDER=yfinance
# BIST_CACHE_TTL_SECONDS=900
# BIST_TD_FALLBACK=false
TWELVE_DATA_API_KEY=

# borsapy + TradingView canlı BIST (borsapy seçildiğinde; cookie'ler süresi dolunca yenileyin)
# TRADINGVIEW_SESSION_ID=
# TRADINGVIEW_SESSION_SIGN=
# Bind address (VPS: HOST=0.0.0.0 so LAN/public clients can connect)
# HOST=0.0.0.0
# PORT=8000

# First admin (created only when users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin!12345

# Session signing (set a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-secret

# Scheduled scan emails (optional — required to send TV list attachments)
# Track defaults: target +8%, stop -5%
# TRACK_DEFAULT_TARGET_PCT=8
# TRACK_DEFAULT_STOP_PCT=5
# TRACK_PRICE_CHECK_TIMEZONE=Europe/Istanbul
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USE_TLS=true, use App Password (not normal password)
# Kurumsal e-posta (Natro/Kurumsal Eposta): SMTP_HOST=mail.kurumsaleposta.com (not mail.yourdomain unless DNS A record exists)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your@gmail.com
# SMTP_USE_TLS=true
# DEFAULT_SCHEDULE_TIMEZONE=Europe/Istanbul
#
# Telegram (optional — zamanlanmış tarama sonuçları e-postaya ek olarak)
# BotFather: @BotFather → /newbot → token
# Chat id: bota bir mesaj yazın, sonra
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# result[0].message.chat.id  (grup için -100... olabilir)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=123456789
